## Sanity Project ID
## Add the ID to both NEXT_PUBLIC_ & SANITY_STUDIO_
## Which is mandatory for localhost:3333 and localhost:3000

NEXT_PUBLIC_SANITY_PROJECT_ID=7srnh1l9
SANITY_STUDIO_PROJECT_ID=7srnh1l9

NEXT_PUBLIC_SANITY_DATASET=production

## Instagram section (optional — section shows a "follow us" empty state without these)
## Requires an Instagram Professional (Business/Creator) account and a token from
## the Facebook Graph API (Instagram API with Instagram Login). INSTAGRAM_USER_ID is
## optional — if omitted, it's resolved automatically from the access token.

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
